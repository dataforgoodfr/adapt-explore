# POSTGRES
POSTGRES_PASSWORD=admin
POSTGRES_USER=admin
POSTGRES_DB=administration

# NOCODB
NC_AUTH_JWT_SECRET=secret
NC_DB=pg://db:5432?u=admin&p=admin&d=administration
NC_ATTACHMENT_FIELD_SIZE=20971520  # default = 20 MB
NC_SECURE_ATTACHMENTS=false
NC_ALLOW_LOCAL_HOOKS=true
NC_ALLOW_LOCAL_EXTERNAL_DBS=true

# YOYO-MIGRATION
YOYO_DB=postgresql+psycopg://localhost:5432?user=admin&password=admin&dbname=adapt_explore
YOYO_SRC=migrations
YOYO_VERBOSITY=2

#S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me_aussi
S3_BUCKET=raw

# FRONTEND
DATABASE_URL=postgresql://admin:admin@localhost/adapt_explore
