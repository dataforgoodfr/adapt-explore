# POSTGRES
POSTGRES_PASSWORD=admin
POSTGRES_USER=admin
POSTGRES_DB=administration

# NOCODB
NC_AUTH_JWT_SECRET=secret
NC_DB=pg://db:5432?u=admin&p=admin&d=administration
NC_ATTACHMENT_FIELD_SIZE=20971520  # default = 20 MB
NC_SECURE_ATTACHMENTS=false
NC_ALLOW_LOCAL_HOOKS=true

# YOYO-MIGRATION
YOYO_DB=postgresql+psycopg://localhost:5432?user=admin&password=admin&database=adapt_explore
YOYO_SRC=migrations
YOYO_VERBOSITY=2